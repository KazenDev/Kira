# Copiá este archivo a .env y completá los valores.
# No subas .env a ningún repositorio.

HIVE_API_KEY=
DEEPSEEK_API_KEY=
NANO_API_KEY=
ELEVENLABS_API_KEY=
AI_GATEWAY_API_KEY=
ASSEMBLYAI_API_KEY=
EXA_API_KEY=

# Opcional: URL de Hive (Virginia usa https://api-va1.thehive.ai/api/v3)
# HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3

# RAG local (normalmente no hace falta tocar esto)
KIRA_RAG_ENABLED=1
KIRA_RAG_PROVIDER=fastembed
KIRA_RAG_MODEL=intfloat/multilingual-e5-small
KIRA_RAG_ALLOW_DOWNLOAD=1

# Cuentas y aislamiento de datos
KIRA_AUTH_REQUIRED=1
# 0 para HTTP local; 1 cuando el servidor está detrás de HTTPS
KIRA_COOKIE_SECURE=0
# Opcionales: rutas por defecto backend/auth.sqlite3 y backend/usuarios/
# KIRA_AUTH_DB=
# KIRA_USERS_DIR=
